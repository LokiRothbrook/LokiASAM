{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "mod-browser",
  "description": "Allows the mod-browser WebviewWindow (loading CurseForge) to emit Tauri events back to the main window.",
  "windows": ["mod-browser"],
  "remote": {
    "urls": [
      "https://www.curseforge.com/*",
      "https://*.curseforge.com/*"
    ]
  },
  "permissions": [
    "core:event:allow-emit"
  ]
}
