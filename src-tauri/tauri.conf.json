{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LokiASAM",
  "version": "0.9.0",
  "identifier": "xyz.lokisoft.lokiasam",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "LokiASAM — Ark Survival Ascended Server Manager",
        "width": 1400,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true,
        "backgroundColor": [5, 5, 16, 255]
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFDMTEwM0RGNEI5QzBGRkMKUldUOEQ1eEwzd01SSElZTUNLeUp2WmFWL3FlUkdjeXpKZUZwVngyenk4K3h5NXR3WjMyZzBjMzAK",
      "endpoints": [
        "https://github.com/LokiRothbrook/LokiASAM/releases/latest/download/latest.json"
      ]
    },
    "sql": {
      "preloadConnections": ["sqlite:lokiasam.db"]
    }
  }
}
